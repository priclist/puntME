# ---- App (read by Vite at build time) ----

# Google Maps Platform key with "Maps JavaScript API", "Places API (New)"
# and "Maps Embed API" enabled. Leave empty to run PuntMe with demo data.
VITE_GOOGLE_MAPS_API_KEY=

# Only when the API runs on a different domain than the app,
# e.g. https://api.puntme.co.za. Leave empty when `npm start` serves both.
VITE_API_URL=

# ---- Server (read by `npm start`) ----

# PORT=8787
# Where the database (puntme.db) and push keys live. Back this folder up.
# PUNTME_DATA_DIR=/var/lib/puntme

# Push notification keys. If empty they're generated once and saved in the
# data folder. Generate a pair with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.co.za

# Only when the app is hosted on another domain than the API.
# CORS_ORIGIN=https://puntme.co.za
